{
	"name": "tankthinks.net",
	"version": "1.0.0",
	"description": "blog built with eleventy & tailwindcss.",
	"packageManager": "pnpm@10.30.1",
	"engines": {
		"node": ">=18",
		"pnpm": ">=9"
	},
	"scripts": {
		"serve": "ELEVENTY_ENV=dev eleventy --serve",
		"start": "pnpm run serve",
		"build": "ELEVENTY_ENV=dev eleventy",
		"build:prod": "ELEVENTY_ENV=prod eleventy"
	},
	"keywords": [
		"11ty",
		"tailwindcss",
		"eleventy",
		"purgecss"
	],
	"author": "tankthinks",
	"license": "ISC",
	"devDependencies": {
		"@11ty/eleventy": "^3.1.2",
		"@11ty/eleventy-navigation": "^1.0.5",
		"@11ty/eleventy-plugin-rss": "^2.0.4",
		"@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
		"autoprefixer": "^10.4.2",
		"luxon": "^3.5.0",
		"markdown-it": "^14.1.0",
		"markdown-it-anchor": "^9.2.0",
		"markdown-it-link-attributes": "^4.0.1",
		"nunjucks": "^3.2.4",
		"postcss-cli": "^11.0.0",
		"tailwindcss": "^3.4.0"
	},
	"dependencies": {
		"cssnano": "^6.0.1"
	},
	"overrides": {
		"minimatch": "^10.2.1",
		"js-yaml": "^4.1.0"
	},
	"pnpm": {
		"overrides": {
			"minimatch": "^10.2.1",
			"js-yaml": "^4.1.0"
		}
	}
}
